local SelectedIsland = nil
local Islands = {}

local islandNames = {"Island 1", "Island 2", "Island 3", "Island 4", "Island 5"}

for _, name in ipairs(islandNames) do
	local success, islandPart = pcall(function()
		return workspace:WaitForChild("SpawnLocation"):WaitForChild(name):WaitForChild("Part")
	end)

	if success and islandPart then
		Islands[name] = islandPart
	end
end

for islandName, islandPart in pairs(Islands) do
	Teleports:AddToggle({
		Name = islandName,
		Default = false,
		Callback = function(state)
			if state then
				SelectedIsland = islandPart

				for otherName, _ in pairs(Islands) do
					if otherName ~= islandName then
						Teleports:UpdateToggle(otherName, false)
					end
				end
			else
				if SelectedIsland == islandPart then
					SelectedIsland = nil
				end
			end
		end
	})
end

