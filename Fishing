local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

Auto:AddButton({
    Name = "Quét tất cả Functions",
    Callback = function()
        local player = Players.LocalPlayer
        local leaderstats = player:WaitForChild("leaderstats")
        local money = leaderstats:WaitForChild("Money")
        
        local Functions = ReplicatedStorage.Communication.Functions
        local children = Functions:GetChildren()
        print("📦 Tổng số Function tìm thấy:", #children)
        
        local sellCommands = {} -- Lưu các lệnh bán
        
        for i, remoteFunction in ipairs(children) do
            if remoteFunction:IsA("RemoteFunction") then
                local moneyBefore = money.Value
                
                local success, result = pcall(function()
                    return remoteFunction:InvokeServer()
                end)
                
                task.wait(0.02)
                
                local moneyAfter = money.Value
                local moneyChange = moneyAfter - moneyBefore
                
                if success then
                    print(string.format("✅ [%d] '%s' => %s", i, remoteFunction.Name, tostring(result)))
                    
                    if moneyChange ~= 0 then
                        local sellInfo = string.format("[%d] '%s' - Thay đổi: %+d", i, remoteFunction.Name, moneyChange)
                        print("💰 Lệnh bán - " .. sellInfo)
                        table.insert(sellCommands, sellInfo)
                    end
                else
                    warn(string.format("❌ [%d] '%s' => Lỗi: %s", i, remoteFunction.Name, tostring(result)))
                end
            else
                print(string.format("⏭️ [%d] '%s' => Bỏ qua (loại: %s)", i, remoteFunction.Name, remoteFunction.ClassName))
            end
            task.wait(0.02)
        end
        
        print("\n🏁 Hoàn tất gọi tất cả Functions.")
        
        if #sellCommands > 0 then
            print("\n=== TÓM TẮT CÁC LỆNH BÁN ===")
            for _, cmd in ipairs(sellCommands) do
                print("💰 " .. cmd)
            end
        else
            print("\n❌ Không tìm thấy lệnh bán nào")
        end
    end
})
