            cursor = result.NextPageCursor
        until not cursor or cursor == ""

        -- Không tìm thấy server nào khác → rejoin bình thường
        if not foundServer then
            TeleportService:Teleport(PLACE_ID, Players.LocalPlayer)
        end
    end
