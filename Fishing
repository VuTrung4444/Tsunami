Auto:AddToggle({
    Name = "Auto Fishing",
    Default = false,
    Callback = function(state)
        running = state
        if not running then
            resetCombo()
            return
        end

        task.spawn(function()
            while running do
                clickM1()

                -- Chờ cá cắn: DistanceFrame thay đổi
                local prevText = readDistText() or ""
                local fishBiting = false
                local waitStart = tick()

                while running do
                    local t = readDistText() or ""
                    if t ~= prevText then
                        fishBiting = true
                        break
                    end
                    if tick() - waitStart >= 2 then break end
                    task.wait(0.05)
                end

                if not fishBiting then continue end

                -- ── Kiểm tra độ hiếm cá ─────────────────────────────────────
                -- Chờ tối đa 0.5s để FishName cập nhật (đôi khi có độ trễ nhỏ)
                local fishAllowed = false
                local checkStart  = tick()
                while tick() - checkStart < 0.5 do
                    if isFishAllowed() then
                        fishAllowed = true
                        break
                    end
                    task.wait(0.05)
                end

                if not fishAllowed then
                    -- Cá không đủ độ hiếm → chờ cá tự thoát, không làm gì
                    while running do
                        local t = readDistText()
                        -- Cá thoát khi cur > max, hoặc text biến mất
                        if t == nil or fishEscaped(t) then break end
                        task.wait(0.1)
                    end
                    -- Sau khi cá thoát → quay lại vòng ngoài để clickM1 câu lại
                    continue
                end
                -- ─────────────────────────────────────────────────────────────

                -- ── Vòng lặp chiêu ──────────────────────────────────────────
                resetCombo()
                local skillBusy     = false
                local lastSkillTime = 0
                local fishActive    = true

                local STALE_SEC      = 1.2
                local watchText      = readDistText() or ""
                local lastChangedAt  = tick()
                local distWasNonZero = false

                task.spawn(function()
                    while running and fishActive do
                        task.wait(0.05)

                        local t = readDistText()
                        if t == nil then
                            fishActive = false
                            break
                        end

                        local curStr = t:match("^(%d+)m/%d+m$")
                        if curStr and tonumber(curStr) > 0 then
                            distWasNonZero = true
                        end

                        if distWasNonZero and fishCaught() then
                            fishActive = false
                            break
                        end

                        if fishEscaped(t) then
                            fishActive = false
                            break
                        end

                        if t ~= watchText then
                            watchText = t
                            lastChangedAt = tick()
                        elseif tick() - lastChangedAt >= STALE_SEC then
                            fishActive = false
                            break
                        end
                    end
                end)

                -- Vòng gọi chiêu
                while running and fishActive do
                    local now = tick()

                    if not skillBusy and now - lastSkillTime >= 0.5 then
                        local k1 = comboStr ~= "" and comboStr:sub(1,1):upper() or nil
                        local k2 = comboStr ~= "" and #comboStr >= 2 and comboStr:sub(2,2):upper() or nil
                        local hasCombo = k1 and k2 and keyCodeMap[k1] and keyCodeMap[k2]

                        local comboBlocked = {}
                        if hasCombo then
                            comboBlocked[k1] = true
                            comboBlocked[k2] = true
                        end
                        local function isBlocked(k) return comboBlocked[k] == true end

                        skillBusy = true
                        lastSkillTime = now

                        task.spawn(function()
                            if not fishActive then
                                skillBusy = false
                                return
                            end

                            if comboPhase == 1 and cachedKey2 ~= nil then
                                pressSkill(cachedKey2)
                                resetCombo()

                            elseif hasCombo then
                                local cd1 = getSkillCooldown(k1)
                                local cd2 = getSkillCooldown(k2)
                                if cd1 == 0 and cd2 <= 4 then
                                    cachedKey1 = k1
                                    cachedKey2 = k2
                                    comboPhase = 1
                                    pressSkill(k1)
                                else
                                    if priorityStr ~= "" then
                                        for i = 1, #priorityStr do
                                            if not fishActive then break end
                                            local kc = priorityStr:sub(i,i):upper()
                                            if not isBlocked(kc) and isSkillReady(kc) then
                                                pressSkill(kc)
                                                break
                                            end
                                        end
                                    else
                                        for _, kc in ipairs({"Z","X","C","V"}) do
                                            if not fishActive then break end
                                            if not isBlocked(kc) and isSkillReady(kc) then
                                                pressSkill(kc)
                                                break
                                            end
                                        end
                                    end
                                end

                            else
                                if priorityStr ~= "" then
                                    for i = 1, #priorityStr do
                                        if not fishActive then break end
                                        local kc = priorityStr:sub(i,i):upper()
                                        if isSkillReady(kc) then
                                            pressSkill(kc)
                                            break
                                        end
                                    end
                                else
                                    for _, kc in ipairs({"Z","X","C","V"}) do
                                        if not fishActive then break end
                                        if isSkillReady(kc) then
                                            pressSkill(kc)
                                            break
                                        end
                                    end
                                end
                            end

                            skillBusy = false
                        end)
                    end

                    task.wait(0.05)
                end

                local t0 = tick()
                while skillBusy and tick() - t0 < 1.5 do
                    task.wait(0.05)
                end
            end
        end)
    end
})


