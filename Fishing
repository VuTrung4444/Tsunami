local function pressKey(keyCode)
    VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
    task.wait(0.5)
    VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
end

local function pressM1()
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
    task.wait(0.1)
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
end

local function isKeyText(text)
    return text == "Z" or text == "X" or text == "C" or text == "V"
end

local function isFishingComplete()
    local success, result = pcall(function()
        local healthText = PlayerGui.FishStats.HealthFrame.HealthText.Text
        local currentHP, maxHP = healthText:match("^(%d+)/(%d+)$")
        if currentHP and tonumber(currentHP) == 0 then
            return true
        end

        local distText = PlayerGui.FishStats.DistanceFrame.HealthText.Text
        local currentDist, maxDist = distText:match("^(%d+)m/(%d+)m$")
        if currentDist and maxDist and tonumber(currentDist) > tonumber(maxDist) then
            return true
        end

        return false
    end)
    if success then return result end
    return false
end

-- ============================================================
-- SKILL MANAGER
-- Map: Skill1=Z, Skill2=X, Skill3=C, Skill4=V
-- ============================================================

local skillMap = {
    { path = "Skill1", key = Enum.KeyCode.Z },
    { path = "Skill2", key = Enum.KeyCode.X },
    { path = "Skill3", key = Enum.KeyCode.C },
    { path = "Skill4", key = Enum.KeyCode.V },
}

local function getSkillInsideText(skillPath)
    local success, text = pcall(function()
        return PlayerGui.RodGUI.Skills[skillPath].Inside.Text
    end)
    if success then return text end
    return nil
end

local function pressAvailableSkill()
    for _, skill in ipairs(skillMap) do
        local text = getSkillInsideText(skill.path)
        if text and isKeyText(text) then
            pressKey(skill.key)
            return true
        end
    end
    return false
end

