local function checkIsMobile()
    local success, pos = pcall(function()
        return PlayerGui.RodGUI.Skills.AbsolutePosition
    end)
    if not success then return false end
    return math.abs(pos.X - 636.539) <= 0.5 and math.abs(pos.Y - 60.251) <= 0.5
end
local isMobile = checkIsMobile()

local function touchClick(x, y)
    VirtualInputManager:SendMouseMoveEvent(x, y, game)
    task.wait(0.05)
    VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
    task.wait(0.1)
    VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
end

local function pressKey(keyCode)
    VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
    task.wait(0.5)
    VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
end

local function pressSkill(keyChar)
    if isMobile then
        local coords = skillTouchCoords[keyChar]
        if coords then
            touchClick(coords.x, coords.y)
        end
    else
        local kc = keyCodeMap[keyChar]
        if kc then
            pressKey(kc)
        end
    end
end

