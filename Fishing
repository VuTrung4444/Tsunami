end

-- Kiểm tra cá có thuộc loại được phép chiến đấu không
-- Trả về true nếu không có filter nào được bật,
-- hoặc tên cá khớp với filter đang bật
local function isFishAllowed()
    -- Nếu không bật filter nào → câu tất cả
    if not filterEpic and not filterLegendary then
        return true
    end

    local name = readFishName()
    if not name then return false end

    if filterEpic and name:match("^Epic%s*%[%d+%]") then
        return true
    end
    if filterLegendary and name:match("^Legendary%s*%[%d+%]") then
        return true
    end

    return false
end

local function parseDist(text)
    if not text then return nil, nil end
    local c, m = text:match("^(%d+)m/(%d+)m$")
    return c and tonumber(c) or nil, m and tonumber(m) or nil
end

local function fishEscaped(text)
    local c, m = parseDist(text)
    return c ~= nil and m ~= nil and c > m
end

local function fishCaught()
    local ok, result = pcall(function()
        local hp = PlayerGui.FishStats.HealthFrame.HealthText.Text
        local cur = hp:match("^(%d+)/%d+$")
        return cur ~= nil and tonumber(cur) == 0
    end)
    return ok and result
end

