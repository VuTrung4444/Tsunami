local function isSkillReady(keyChar)
    local path = skillPathMap[keyChar]
    if not path then return false end
    local ok, text = pcall(function()
        return PlayerGui.RodGUI.Main.Skills[path].Inside.Text
    end)
    return ok and text == keyChar
end

local function getSkillCooldown(keyChar)
    local path = skillPathMap[keyChar]
    if not path then return 0 end
    local ok, text = pcall(function()
        return PlayerGui.RodGUI.Main.Skills[path].Inside.Text
    end)
    if not ok then return 0 end
    if text == keyChar then return 0 end
    local s = text:match("^(%d+)s$")
    if s then return tonumber(s) end
    return 999
end

local function readDistText()
