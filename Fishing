Auto:AddToggle({
    Name = "Auto Fishing",
    Default = false,
    Callback = function(state)
        running = state

        if not running then
            resetCombo()
            return
        end

        task.spawn(function()
            while running do
                clickM1()

                local prevDistText = ""
                pcall(function()
                    prevDistText = PlayerGui.FishStats.DistanceFrame.HealthText.Text
                end)

                local fishBiting = false
                local waitStart = tick()

                while running do
                    local currentDistText = ""
                    pcall(function()
                        currentDistText = PlayerGui.FishStats.DistanceFrame.HealthText.Text
                    end)

                    if currentDistText ~= prevDistText then
                        fishBiting = true
                        break
                    end

                    if tick() - waitStart >= 1 then
                        break
                    end

                    task.wait(0.05)
                end

                if fishBiting then
                    resetCombo()
                    local lastSkillTime = 0
                    local skillBusy = false

                    while running do
                        local now = tick()

                        if isFishingComplete() then
                            task.wait(1)
                            break
                        end

                        if not skillBusy and now - lastSkillTime >= 0.5 then
                            local k1 = comboStr ~= "" and comboStr:sub(1,1):upper() or nil
                            local k2 = comboStr ~= "" and #comboStr >= 2 and comboStr:sub(2,2):upper() or nil
                            local hasCombo = k1 and k2 and keyCodeMap[k1] and keyCodeMap[k2]

                            local comboBlocked = {}
                            if hasCombo then
                                comboBlocked[k1] = true
                                comboBlocked[k2] = true
                            end

                            local function isBlocked(k) return comboBlocked[k] == true end

                            skillBusy = true
                            lastSkillTime = now

                            task.spawn(function()
                                if comboPhase == 1 and cachedKey2 ~= nil then
                                    pressSkill(cachedKey2)
                                    resetCombo()

                                elseif hasCombo then
                                    local cd1 = getSkillCooldown(k1)
                                    local cd2 = getSkillCooldown(k2)
                                    if cd1 == 0 and cd2 <= 4 then
                                        cachedKey1 = k1
                                        cachedKey2 = k2
                                        comboPhase = 1
                                        pressSkill(k1)
                                    else
                                        if priorityStr ~= "" then
                                            for i = 1, #priorityStr do
                                                local kc = priorityStr:sub(i,i):upper()
                                                if not isBlocked(kc) and isSkillReady(kc) then
                                                    pressSkill(kc)
                                                    break
                                                end
                                            end
                                        else
                                            for _, kc in ipairs({"Z","X","C","V"}) do
                                                if not isBlocked(kc) and isSkillReady(kc) then
                                                    pressSkill(kc)
                                                    break
                                                end
                                            end
                                        end
                                    end

                                else
                                    if priorityStr ~= "" then
                                        for i = 1, #priorityStr do
                                            local kc = priorityStr:sub(i,i):upper()
                                            if isSkillReady(kc) then
                                                pressSkill(kc)
                                                break
                                            end
                                        end
                                    else
                                        for _, kc in ipairs({"Z","X","C","V"}) do
                                            if isSkillReady(kc) then
                                                pressSkill(kc)
                                                break
                                            end
                                        end
                                    end
                                end

                                skillBusy = false
                            end)
                        end

                        task.wait(0.05)
                    end
                end
            end
        end)
    end
})



