local TeleportService = game:GetService("TeleportService")
local Players = game:GetService("Players")
local PLACE_ID = game.PlaceId
local currentJobId = game.JobId

local foundServer = false
local cursor = ""

repeat
    local ok, result = pcall(function()
        return Players:GetServerList(PLACE_ID, cursor)
    end)
    if not ok then break end

    local candidates = {}
    for _, server in ipairs(result.Servers) do
        if server.Id ~= currentJobId and server.Playing < server.MaxPlayers then
            table.insert(candidates, server)
        end
    end

    if #candidates > 0 then
        local chosen = candidates[math.random(1, #candidates)]
        foundServer = true
        TeleportService:TeleportToPlaceInstance(PLACE_ID, chosen.Id, Players.LocalPlayer)
        break
    end

    cursor = result.NextPageCursor
until not cursor or cursor == ""

if not foundServer then
    print("Không tìm thấy server khác, rejoin server hiện tại")
    TeleportService:Teleport(PLACE_ID, Players.LocalPlayer)
end
