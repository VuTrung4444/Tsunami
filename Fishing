Auto:AddToggle({
    Name = "Auto Fishing",
    Default = false,
    Callback = function(state)
        running = state

        if not running then
            resetCombo()
            return
        end

        task.spawn(function()
            while running do
                pressM1()

                local prevDistText = ""
                pcall(function()
                    prevDistText = PlayerGui.FishStats.DistanceFrame.HealthText.Text
                end)

                local fishBiting = false
                local waitStart = tick()

                while running do
                    local currentDistText = ""
                    pcall(function()
                        currentDistText = PlayerGui.FishStats.DistanceFrame.HealthText.Text
                    end)

                    if currentDistText ~= prevDistText then
                        fishBiting = true
                        break
                    end

                    if tick() - waitStart >= 1 then
                        break
                    end

                    task.wait(0.05)
                end

                if fishBiting then
                    resetCombo()
                    local lastSkillTime = 0

                    while running do
                        local now = tick()

                        if isFishingComplete() then
                            task.wait(1)
                            break
                        end

                        if now - lastSkillTime >= 0.5 then
                            local pressed = pressNextSkill()
                            if pressed then
                                lastSkillTime = now
                            end
                        end

                        task.wait(0.05)
                    end
                end
            end
        end)
    end
})

